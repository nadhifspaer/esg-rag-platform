ENVIRONMENT=development

CORS_ALLOW_ORIGINS=http://localhost:3005,https://esg-rag-platform.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=esg-page-images

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=esg_documents

#OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_GENERATION_MODEL_HIGH=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL_HIGH=gpt-4.1

# Rate Limit
RATE_LIMIT_UNITS_PER_HOUR=120
RATE_LIMIT_BURST_UNITS=120

# Re-ranker
RERANKER_PROVIDER=onnx
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_N=5
ONNX_RERANKER_FILENAME=onnx/model_quint8_avx2.onnx

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# Smoke Test Account
SMOKE_TEST_DEMO_EMAIL=
SMOKE_TEST_DEMO_PASSWORD=
SMOKE_TEST_BASE_URL=
