# Frontend environment. Copy to `.env.local` and fill in: cp .env.local.example .env.local
# NEXT_PUBLIC_* variables are inlined into the JS bundle at build time and are therefore PUBLIC.


# Backend API: base URL of the FastAPI backend; must appear in the backend's CORS_ALLOW_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# Supabase: auth only (the frontend never queries the database directly).
# Same value as the backend's SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable "anon" key, public by design; respects row-level security, never a bearer token.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Shared demo account (v1 has no public signup), kept out of NEXT_PUBLIC_ so the password never enters the JS bundle.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
